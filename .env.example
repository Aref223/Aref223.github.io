# Application Settings
APP_NAME=Visa and Debit Card Scraper
VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Security Settings
SECRET_KEY=your-super-secret-key-here-make-it-at-least-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings
DATABASE_URL=postgresql://postgres:password@localhost:5432/visa_scraper
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
DATABASE_POOL_TIMEOUT=30

# Redis Settings
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# API Settings
API_V1_STR=/api/v1
PROJECT_NAME=Visa Scraper API
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Scraping Settings
SCRAPER_TIMEOUT=30
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_DELAY_BETWEEN_REQUESTS=1.0
MAX_CONCURRENT_SCRAPERS=5

# Validation Settings
CARD_VALIDATION_ENABLED=true
EMAIL_VALIDATION_ENABLED=true
PHONE_VALIDATION_ENABLED=true

# File Storage
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=["csv", "xlsx", "json"]

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Monitoring
SENTRY_DSN=
ENABLE_METRICS=true

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# Encryption
ENCRYPTION_KEY=your-encryption-key-here-make-it-at-least-32-characters-long
ENCRYPTION_ALGORITHM=AES-256-GCM